DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

SECRET_KEY=

# Hosts permitidos por Django, sin incluir http:// ni https://.
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes completos permitidos para aplicaciones web, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Límite de solicitudes: cantidad/período (por ejemplo, 5/minute).
THROTTLE_ANON_RATE=30/minute
THROTTLE_USER_RATE=100/minute
THROTTLE_LOGIN_RATE=5/minute

# Duración de los tokens JWT.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
# TLS cifra el envío de correos mediante el servidor SMTP.
EMAIL_USE_TLS=true

# Configuración HTTPS. En desarrollo se pueden dejar en false.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# true solo si el hosting/proxy termina HTTPS antes de llegar a Django.
TRUST_PROXY_SSL=false

# HSTS: activar solo cuando HTTPS funcione correctamente en todo el dominio.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true